{
  "name": "Hemlock",
  "version": "0",
  "manifest_version": 2,
  "description": "Simplify by removing the unecessary influences on your life.",
  "browser_action": {
    "default_icon": "icon.png",
    "default_popup": "panel.html"
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": false
  },
  "permissions": [
    "storage", "activeTab"
  ],
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "css": ["style.css"],
    "js": ["jquery.js", "lodash.js", "js-yaml.js", "contentScript.js", "genWords.js"]
  }],
  "options_ui": {
    "page": "panel.html",
    "chrome_style": true
  }
}